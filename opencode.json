{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "deny",
      "docs/.agent-briefs/hsdc-poc-research-*.md": "allow"
    },
    "bash": {
      "*": "deny",
      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "git diff*": "allow",
      "git status*": "allow",
      "git add*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "npm install*": "deny",
      "npm i *": "deny"
    },
    "webfetch": "allow"
  }
}
