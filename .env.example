# Copy to .env (untracked) and fill in. Never commit real values.
# Spring Boot reads these as OS environment variables (ADR-000 §7).

# Required: OpenRouter API key (sk-or-v1-...). Never baked into the Docker image.
OPENROUTER_API_KEY=
# SDK base URL (default shown)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Decision + chat model, and image assessment model
LLM_MODEL=openai/gpt-6-luna
LLM_VISION_MODEL=openai/gpt-6-luna
# Reasoning effort: first decision (default medium), chat replies (default low)
LLM_DECISION_REASONING_EFFORT=medium
LLM_CHAT_REASONING_EFFORT=low

# Pre-screening (ADR-004): shadow | gated | llm-only
DECISIONS_MODE=shadow
# Exact model slug, no ~latest alias (ADR-004 Decision 6.6)
DECISIONS_MODEL=typesafe/jev-1.14
DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
# Minimum confidence per pre-screen question for a CONFIDENT gate
DECISIONS_CONFIDENCE_THRESHOLD=0.80

# HMAC key for CaseContext signatures: at least 32 random bytes, Base64.
# Empty = generated at startup (logged as a warning); signatures then break after restart.
# Generate with: openssl rand -base64 32
CASE_SIGNING_KEY=

# Rate limits per client IP per hour
RATE_LIMIT_CASES_PER_HOUR=10
RATE_LIMIT_CHAT_PER_HOUR=60

# HTTP port inside the container / local run
SERVER_PORT=8080
