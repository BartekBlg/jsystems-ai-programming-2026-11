# Installed Agent Skills are not committed. skills-lock.json is committed as the
# source of truth for which skills are used and at which commit; restore them with
# `npx skills install` (add --frozen-lockfile to fail instead of changing the lock).
# .claude/skills/ holds the CLI's links to them.
.agents/skills/
.claude/skills/
__pycache__/
*.pyc
.playwright-cli
playwright-report/
test-results/
playwright/.cache/

# Local Codex history, credentials and runtime state; keep shared config and rules.
.codex/auth.json
.codex/sessions/
.codex/archived_sessions/
.codex/history.jsonl
.codex/session_index.jsonl
.codex/log/
.codex/logs/
.codex/tmp/
.codex/*.sqlite*

# Private agent briefs and Java build artifacts
.agent-briefs/
**/target/
*.class
/.idea
