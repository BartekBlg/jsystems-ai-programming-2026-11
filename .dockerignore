# Keep the build context small and free of host state and secrets.
# Note: patterns without a leading **/ match only at the repository root.

# Dependencies and build output (rebuilt inside the image)
**/node_modules
**/target
**/dist

# Secrets and local env files (.env.example stays for reference)
.env
.env.*
!.env.example

# VCS, agent and tool state
.git
.agent-logs
.claude
.playwright-cli
test-results
playwright-report
**/test-results
**/playwright-report
